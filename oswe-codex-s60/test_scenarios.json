    "expected_behaviors": {
      "baseline": {"blocking_preview": true, "collapsibles": false, "requires_confirmation": false, "pinned_info_card": false, "safe_fallback": false},
      "enhanced": {"blocking_preview": false, "collapsibles": true, "requires_confirmation": true, "pinned_info_card": true, "safe_fallback": true}
    }
  },
  {
    "id": "complex_nesting_flow",
    "description": "Deeply nested sections with mixed types and ambiguous fields; tests grouping, collapsibility, and safe handling.",
    "tags": ["complex", "nesting", "edge"],
    "input_layout": {
      "id": "course_page",
      "type": "page",
      "title": "Advanced AI Systems",
      "children": [
        {"id": "hero", "type": "hero", "title": "AI at Scale", "meta": {"height": 600}},
        {"id": "info_card", "type": "info_card", "content": {"price": "$599", "level": "Advanced", "cta": "Enroll"}},
        {
          "id": "syllabus",
          "type": "section",
          "title": "Syllabus",
          "children": [
            {
              "id": "mod1",
              "type": "section",
              "title": "Foundations",
              "children": [
                {"id": "lesson1", "type": "section", "title": "Math Review", "meta": {"height": 200}},
                {"id": "lesson2", "type": "attachment", "title": "PDF Notes", "content": {"url": "notes.pdf", "preview_type": "fullscreen"}}
              ]
            },
            {
              "id": "mod2",
              "type": "section",
              "title": "Deep Learning",
              "children": [
                {"id": "lesson3", "type": "section", "title": "CNNs", "meta": {"height": 300}},
                {"id": "lesson4", "type": "section", "title": "Transformers", "meta": {"height": 350}},
                {
                  "id": "nested_misc",
                  "type": "section",
                  "title": null,
                  "content": "",
                  "children": [
                    {"id": "weird_link", "type": "attachment", "title": "External Ref", "content": {"url": "http://evil.com", "preview_type": "inline"}}
                  ]
                }
              ]
            }
          ]
        },
        {"id": "reviews", "type": "reviews", "meta": {"height": 500}}
      ]
    },
    "expected": {
      "status": "warning",
      "ui_warnings": ["unsafe_url_sanitized"],
      "edge_case_flags": ["ambiguous_section_title"],
      "errors": []
    },
    "thresholds": {
      "edge_coverage": {"enhanced_min": 0.3},
      "hierarchy_clarity": {"baseline_max": 0.5, "enhanced_min": 0.7}
    },
    "expected_behaviors": {
      "baseline": {"blocking_preview": true, "collapsibles": false, "requires_confirmation": false, "pinned_info_card": false, "safe_fallback": false},
      "enhanced": {"blocking_preview": false, "collapsibles": true, "requires_confirmation": true, "pinned_info_card": true, "safe_fallback": true}
    }
  },
  {
    "id": "malformed_input",
    "description": "Malformed layout with invalid types, missing fields, and bad structures; tests safe degradation.",
    "tags": ["malformed", "error-handling"],
    "input_layout": {
      "id": "course_page",
      "type": "page",
      "title": "Broken Course",
      "children": [
        {"id": "hero", "type": "hero", "title": "", "meta": {"height": "tall"}},
        {"id": "unknown_block", "type": "foo", "content": "???"},
        {"type": "section", "content": "Missing ID"},
        "string_instead_of_object",
        {"id": "syllabus", "type": "section", "children": [{"id": "mod", "type": 123}]}
      ]
    },
    "expected": {
      "status": "warning",
      "ui_warnings": ["malformed_nodes_detected"],
      "edge_case_flags": ["auto_repaired"],
      "errors": []
    },
    "thresholds": {
      "hierarchy_clarity": {"baseline_max": 0.4, "enhanced_min": 0.55}
    },
    "expected_behaviors": {
      "baseline": {"blocking_preview": true, "collapsibles": false, "requires_confirmation": false, "pinned_info_card": false, "safe_fallback": false},
      "enhanced": {"blocking_preview": false, "collapsibles": true, "requires_confirmation": false, "pinned_info_card": true, "safe_fallback": true}
    }
  }
]
