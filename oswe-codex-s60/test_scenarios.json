[
  {
    "id": "normal_flow",
    "description": "Standard course with hero, info card, syllabus, reviews. Tests hierarchy restructuring and collapsibles.",
    "tags": ["normal", "hierarchy", "collapsible"],
    "input_layout": {
      "id": "course_page",
      "type": "page",
      "title": "Mastering Data Science",
      "meta": {"hero_height": 620},
      "children": [
        {
          "id": "hero",
          "type": "hero",
          "title": "Become a Data Scientist",
          "content": "Learn Python, ML, and deployment.",
          "meta": {"height": 620}
        },
        {
          "id": "info_card",
          "type": "info_card",
          "content": {"price": "$199", "level": "Intermediate", "tags": ["Python", "ML"], "cta": "Enroll Now"},
          "meta": {"position": "below_hero"}
        },
        {
          "id": "syllabus",
          "type": "section",
          "title": "Syllabus",
          "meta": {"collapsible": true, "default_expanded": true},
          "children": [
            {"id": "mod1", "type": "section", "title": "Intro", "content": "Overview", "meta": {"height": 300}},
            {"id": "mod2", "type": "section", "title": "Python", "content": "Basics", "meta": {"height": 400}}
          ]
        },
        {
          "id": "reviews",
          "type": "reviews",
          "title": "Reviews",
          "meta": {"rating": 4.6, "height": 500}
        }
      ]
    },
    "expected": {
      "status": "ok",
      "ui_warnings": [],
      "edge_case_flags": [],
      "errors": []
    },
    "thresholds": {
      "hierarchy_clarity": {"baseline_max": 0.55, "enhanced_min": 0.7},
      "scroll_length": {"baseline_min": 1400, "enhanced_max": 1100},
      "misop_risk": {"baseline_min": 0.4, "enhanced_max": 0.25}
    },
    "expected_behaviors": {
      "baseline": {"blocking_preview": true, "collapsibles": false, "requires_confirmation": false, "pinned_info_card": false, "safe_fallback": false},
      "enhanced": {"blocking_preview": false, "collapsibles": true, "requires_confirmation": true, "pinned_info_card": true, "safe_fallback": true}
    }
  },
  {
    "id": "mis_operation_flow",
    "description": "Critical actions without confirmations and potential public/internal confusion.",
    "tags": ["mis-operation", "safety"],
    "input_layout": {
      "id": "course_page",
      "type": "page",
      "title": "Secure DevOps",
      "meta": {},
      "children": [
        {"id": "hero", "type": "hero", "title": "Secure your pipelines", "meta": {"height": 580}},
        {"id": "info_card", "type": "info_card", "content": {"price": "$299", "cta": "Pay & Enroll"}},
        {"id": "author_notes", "type": "notes", "title": "Internal Notes", "content": "Draft syllabus", "meta": {"public": false, "height": 200}},
        {"id": "syllabus", "type": "section", "title": "Syllabus", "meta": {}, "children": []},
        {"id": "dangerous_action", "type": "action", "title": "Publish Course", "meta": {"dangerous_action": true}}
      ]
    },
    "expected": {
      "status": "ok",
      "ui_warnings": ["dangerous_action_without_confirmation"],
      "edge_case_flags": ["public_internal_confusion"],
      "errors": []
    },
    "thresholds": {
      "misop_risk": {"baseline_min": 0.6, "enhanced_max": 0.3},
      "hierarchy_clarity": {"baseline_max": 0.5, "enhanced_min": 0.65}
    },
    "expected_behaviors": {
      "baseline": {"blocking_preview": true, "collapsibles": false, "requires_confirmation": false, "pinned_info_card": false, "safe_fallback": false},
      "enhanced": {"blocking_preview": false, "collapsibles": true, "requires_confirmation": true, "pinned_info_card": true, "safe_fallback": true}
    }
  },
  {
