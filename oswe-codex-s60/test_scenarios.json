        {
          "id": "syllabus",
          "type": "section",
          "title": "Syllabus",
          "children": [
            {"id": "mod1", "type": "section", "title": "HTML", "meta": {"height": 400}},
            {"id": "mod2", "type": "section", "title": "CSS", "meta": {"height": 450}},
            {"id": "mod3", "type": "section", "title": "JavaScript", "meta": {"height": 500}},
            {"id": "mod4", "type": "section", "title": "Node", "meta": {"height": 500}},
            {"id": "mod5", "type": "section", "title": "Databases", "meta": {"height": 500}},
            {"id": "mod6", "type": "section", "title": "DevOps", "meta": {"height": 500}},
            {"id": "mod7", "type": "section", "title": "Cloud", "meta": {"height": 500}},
            {"id": "mod8", "type": "section", "title": "Capstone", "meta": {"height": 500}}
